{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "lib/client-types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false
  },
  // Include client files plus cross-directory imports (panel.tsx → ../filter.ts,
  // ../import-decision.ts). emitDeclarationOnly ensures only .d.ts files land
  // in lib/client-types/, never .js.
  "include": ["src/client/**/*", "src/filter.ts", "src/import-decision.ts", "src/css-modules.d.ts"],
  "exclude": ["node_modules", "lib"]
}
