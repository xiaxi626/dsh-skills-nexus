{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "lib/client-types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false
  },
  // `src/client/**/*` rather than `**/*.ts` + `**/*.tsx`: the `*.module.css`
  // declaration shim is a `.d.ts`, and a `.ts`-only glob silently skips it —
  // which turns every `import css from './x.module.css'` into TS2307 even
  // though the stylesheet and its loader both exist (the same trap the test
  // tsconfig documents on its own `include`). The shim itself lives one level
  // up in `src/`, so it needs its own entry.
  "include": ["src/client/**/*", "src/css-modules.d.ts"],
  "exclude": ["node_modules", "lib"]
}
