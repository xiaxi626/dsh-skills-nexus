{
  "name": "dsh-skills-nexus",
  "version": "0.4.0",
  "description": "Universal DSH skill adapter — register any GitHub SKILL.md repo as a DSH skill via one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaxi626/dsh-skills-nexus.git"
  },
  "homepage": "https://github.com/xiaxi626/dsh-skills-nexus",
  "bugs": {
    "url": "https://github.com/xiaxi626/dsh-skills-nexus/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "bin": {
    "dsh-skills-nexus": "lib/cli/index.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/client-types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./resolve": "./lib/resolve.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown && tsc -p tsconfig.client-types.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/add.test.ts test/api.test.ts test/args.test.ts test/completions.test.ts test/doctor.test.ts test/frontmatter.test.ts test/git.test.ts test/git-sparse-probe.test.ts test/glob.test.ts test/health.test.ts test/link.test.ts test/locks.test.ts test/list.test.ts test/locator.test.ts test/manifest.test.ts test/ops-io.test.ts test/progress.test.ts test/remove.test.ts test/repo-kind.test.ts test/resolve.test.ts test/switch-version.test.ts test/toggle.test.ts test/update-pipeline.test.ts test/update.test.ts test/zip.test.ts",
    "test:build": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "cli": "node --import tsx src/cli/index.ts"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "eslint": "^9.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
